{
  "name": "convex",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "convex",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx convex dev",
        "cwd": "."
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx convex deploy",
        "cwd": "."
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/seed_convex.sh",
        "cwd": "."
      }
    }
  }
}
